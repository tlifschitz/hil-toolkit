# Device-under-test config. Copy to dut.env (gitignored) and fill in.
#   cp dut.env.example dut.env
# Every wrapper sources dut.env via lib.sh.

# --- target + probe ---------------------------------------------------------
CHIP=nRF54L15_M33               # probe-rs target name; list them: probe-rs chip list
# PROBE=                        # VID:PID[:serial] — only needed with >1 probe plugged in
# PROBE_RS=probe-rs             # override to pin a specific binary
# GDB=arm-none-eabi-gdb
# GDB_PORT=1337

# --- firmware ---------------------------------------------------------------
# Relative paths resolve against the directory holding this toolkit.
FIRMWARE=build/firmware.elf     # ELF: gdb symbols + the RTT control block
# FLASH_IMAGE=                  # defaults to FIRMWARE; set for a separate/wrapped image
# FLASH_ADDR=0x0                # only used when FLASH_IMAGE is a raw .bin
HIL_BUILD_CMD="make -j$(nproc)" # run by build.sh before every flash

# --- serial console ---------------------------------------------------------
SERIAL_PORT=/dev/ttyACM0        # CDC from the onboard bridge, or a USB-UART adapter
SERIAL_BAUD=115200

# --- bench scope (Rigol DS1000Z over USBTMC; optional) -----------------------
# SCOPE_DEV=/dev/usbtmc0        # kernel usbtmc char node (default); see README for the udev rule

# --- PPK2 power profiler (Nordic, source-meter mode; optional) ---------------
# PPK_PORT=                     # serial node; default auto-discover /dev/serial/by-id/*PPK2*-if01
# PPK_VOLTAGE_MV=3300           # DUT supply for --power sessions (also feeds calibration math)
# PPK_PYTHON=python3            # interpreter with numpy + pyserial
